# Runtime-only variables; never NEXT_PUBLIC_. The integrated Railway container
# inherits the existing site's configuration. Do not paste keys into source.
GEMINI_API_KEY=
# Optional model override. Defaults to existing GEMINI_MODEL or gemini-3.1-flash-lite.
EDGE_GEMINI_MODEL=
GUEST_SESSION_SECRET=
DATA_DIR=/tmp/obligepay
