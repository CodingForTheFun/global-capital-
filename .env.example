# App
PORT=3000
DEMO_MODE=false
AUTO_SCAN_MINUTES=30
MAX_CANDIDATES=60
SCAN_CONCURRENCY=3
PREFILTER=true
HEADLESS=true
DATA_DIR=./data
DIAGNOSTICS=true

# --- Accounts (Supabase Auth) ----------------------------------------------
# The dashboard is gated by real user accounts. The shared DASHBOARD_PASSWORD
# gate has been removed; these are required for anyone to sign in.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
# Optional. Needed only for admin surfaces that list or modify other users.
SUPABASE_SERVICE_ROLE_KEY=

# Backend ingest token. Its SHA-256 hash must be enabled in
# private.autoscout_backend_tokens. Used by autoscout_ingest_board and
# autoscout_line_history.
AUTOSCOUT_BACKEND_TOKEN=

# --- Data providers (all optional; each is fail-closed when unset) ----------
SPORTSDATAIO_API_KEY=
ODDS_API_KEY=
SCORES_API_KEY=
HEADSHOT_API_KEY=
HEADSHOT_BASE_URL=

# Optional: separate secret for the encrypted session cookie.
# Defaults to a key derived from AUTOPROP_MASTER_KEY.
AUTH_SESSION_SECRET=
AUTH_SESSION_DAYS=30
AUTH_ALLOW_SIGNUP=true
AUTH_ALERT_NEW_DEVICE=true

# IMPORTANT: for 6-digit email codes (instead of magic links), the Supabase
# email templates for "Confirm signup" and "Reset password" must include the
# {{ .Token }} variable. Set these under Authentication > Email Templates.

# --- Security alert email (new device, password changed) --------------------
# Supabase sends the verification and reset codes. These optional settings are
# only for this app's own security notifications. Leave unset to log them.
# MAIL_PROVIDER: resend | postmark | sendgrid | smtp | console
MAIL_PROVIDER=
MAIL_FROM=
MAIL_FROM_NAME=AutoProp Scout Pro
MAIL_REPLY_TO=
APP_URL=
RESEND_API_KEY=
POSTMARK_SERVER_TOKEN=
SENDGRID_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# Encryption key for PickFinder credentials + saved browser session.
# Recommended in production. Any long random value works; 32-byte base64 or 64-char hex is ideal.
AUTOPROP_MASTER_KEY=

# PickFinder. Leave email/password blank and connect from the dashboard instead.
PICKFINDER_EMAIL=
PICKFINDER_PASSWORD=
PICKFINDER_BASE_URL=https://www.pickfinder.app
PICKFINDER_PROPS_URL=https://www.pickfinder.app/props
PICKFINDER_SIGN_IN_URL=https://www.pickfinder.app/sign-in

# Scan rules
TONIGHT_ONLY=true
REGULAR_LINES_ONLY=true
PRIZEPICKS_ONLY=true
STRICT_MODE=true
MIN_L5=80
MIN_L10=75
MIN_L15=75
MIN_H2H=75
MIN_EXPECTED_OUTCOME=75
MIN_FILTER_HIT_RATE=75

# Optional display-only value
PAYOUT_MULTIPLIER=
