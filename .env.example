# App
PORT=3000
DEMO_MODE=false
AUTO_SCAN_MINUTES=30
MAX_CANDIDATES=60
SCAN_CONCURRENCY=3
PREFILTER=true
HEADLESS=true
DATA_DIR=./data
DIAGNOSTICS=true

# Protect the dashboard before exposing it publicly.
DASHBOARD_PASSWORD=change-this-to-a-long-private-password
# Optional: provide a separate long random secret for the signed login cookie.
DASHBOARD_SESSION_SECRET=

# Encryption key for PickFinder credentials + saved browser session.
# Recommended in production. Any long random value works; 32-byte base64 or 64-char hex is ideal.
AUTOPROP_MASTER_KEY=

# PickFinder. Leave email/password blank and connect from the dashboard instead.
PICKFINDER_EMAIL=
PICKFINDER_PASSWORD=
PICKFINDER_BASE_URL=https://www.pickfinder.app
PICKFINDER_PROPS_URL=https://www.pickfinder.app/props
PICKFINDER_SIGN_IN_URL=https://www.pickfinder.app/sign-in

# Scan rules
TONIGHT_ONLY=true
REGULAR_LINES_ONLY=true
PRIZEPICKS_ONLY=true
STRICT_MODE=true
MIN_L5=80
MIN_L10=75
MIN_L15=75
MIN_H2H=75
MIN_EXPECTED_OUTCOME=75
MIN_FILTER_HIT_RATE=75

# Optional display-only value
PAYOUT_MULTIPLIER=

# SportsDataIO stats provider (optional).
# Supplies projections, injuries, expected minutes, starter status, opponent
# rank and game start times. Without a key, props are shown un-enriched and the
# provider reports as "not connected" — no values are estimated in its place.
# One key for everything:
SPORTSDATAIO_API_KEY=
# Or per-league keys, if your subscription issues one key per feed:
# SPORTSDATAIO_KEY_NBA=
# SPORTSDATAIO_KEY_NFL=
# SPORTSDATAIO_KEY_MLB=
# SPORTSDATAIO_KEY_NHL=
# Coverage is a product limit, not a subscription tier. Projections exist for
# NBA, NFL, MLB and NHL (and for CS2/LOL, not yet mapped). No projections feed
# exists for WNBA, NCAAF, NCAAB, tennis, Valorant, Dota 2 or Call of Duty, so
# props in those leagues are always returned un-enriched no matter the plan.
