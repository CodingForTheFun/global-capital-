node_modules
.env
.git
.gitignore
data/*
!data/.gitkeep
*.zip

# Retired sportsbook/guest frontend retained in Git history only, never in runtime.
apps/guest-dashboard
public/edge-workspace-*
public/edge-theme.css
artifacts
test-results

# Development, audit and coordination files never needed by the live service.
# Tests are intentionally included in the Docker build context so every Railway
# image must pass the real release suite before the runtime patch mutates files.
.claude
.github
docs
coverage
playwright-report
.cache
*.md
*.log
npm-debug.log*
.DS_Store

# Runtime bundles are regenerated by frontdoor-clearsports.mjs at container start.
.scout-ui-v5-runtime.js
.frontdoor-clearsports-runtime.mjs
apex-v2/.server-core-propline-runtime.mjs
