# App
PORT=3000
DEMO_MODE=false
AUTO_SCAN_MINUTES=30
MAX_CANDIDATES=60
SCAN_CONCURRENCY=3
PREFILTER=true
HEADLESS=true
DATA_DIR=./data
DIAGNOSTICS=true

# Protect the dashboard before exposing it publicly.
DASHBOARD_PASSWORD=change-this-to-a-long-private-password
# Optional: provide a separate long random secret for the signed login cookie.
DASHBOARD_SESSION_SECRET=

# Encryption key for legacy PickFinder credentials + saved browser session.
# Recommended in production. Any long random value works; 32-byte base64 or 64-char hex is ideal.
AUTOPROP_MASTER_KEY=

# Legacy PickFinder workflow. Optional; the production prop feed does not require it.
PICKFINDER_EMAIL=
PICKFINDER_PASSWORD=
PICKFINDER_BASE_URL=https://www.pickfinder.app
PICKFINDER_PROPS_URL=https://www.pickfinder.app/props
PICKFINDER_SIGN_IN_URL=https://www.pickfinder.app/sign-in

# Auto Scout primary odds provider. SERVER-SIDE ONLY.
# Set THE_ODDS_API_KEY in Railway Variables; never commit the real value.
THE_ODDS_API_KEY=
THE_ODDS_API_MONTHLY_CREDITS=20000
THE_ODDS_API_MAX_EVENTS=2
THE_ODDS_API_MAX_MARKETS_PER_EVENT=6
# Optional comma-separated provider bookmaker keys. Leave blank for Auto Scout defaults.
THE_ODDS_API_BOOKMAKERS=

# Auto Scout normalized PostgreSQL/Supabase persistence. SERVER-SIDE ONLY.
# These enable durable events/players/props/current lines/line snapshots.
AUTOSCOUT_SUPABASE_URL=
AUTOSCOUT_SUPABASE_SERVICE_ROLE_KEY=

# Scan rules
TONIGHT_ONLY=true
REGULAR_LINES_ONLY=true
PRIZEPICKS_ONLY=true
STRICT_MODE=true
MIN_L5=80
MIN_L10=75
MIN_L15=75
MIN_H2H=75
MIN_EXPECTED_OUTCOME=75
MIN_FILTER_HIT_RATE=75

# Optional display-only value
PAYOUT_MULTIPLIER=

# Legacy/future sports-intelligence enrichment provider.
# The current trial key may not include production feeds; missing fields stay unavailable.
SPORTSDATAIO_API_KEY=

# --- Account authentication -------------------------------------------------
# Transactional email for verification and password-reset codes.
# Configure ONE provider. All are HTTP APIs, so no npm dependency is required.
# Without one, codes are logged to the server console in development and NOT
# delivered in production - sign-up cannot complete.
MAIL_FROM=
RESEND_API_KEY=
# POSTMARK_API_TOKEN=
# SENDGRID_API_KEY=
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=

# --- Founding Pro recurring billing ----------------------------------------
# Billing is fail-closed. PayPal credentials by themselves cannot start a
# charge. BILLING_ENABLED must be explicitly true, and a recurring PayPal plan
# plus webhook ID must also be configured. Keep this false until the plan,
# webhook, policies, commercial data rights, and production smoke test are all
# approved.
BILLING_ENABLED=false
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_PLAN_ID=
PAYPAL_WEBHOOK_ID=
PAYPAL_PRODUCT_NAME=Oblige Props Founding Pro
PAYPAL_BRAND_NAME=Oblige Props
# Configure the PayPal webhook URL as:
# https://<production-host>/api/payments/webhook

# Legacy one-time Orders v2 compatibility only. The customer checkout no longer
# uses this value; recurring pricing is read from the active PayPal plan.
PAYPAL_PRICE_USD=
PAYPAL_CURRENCY=USD

# Player-prop projection module (POST /api/props/project).
# Dormant until ANTHROPIC_API_KEY is present: with no key every call reports
# the feature as unavailable rather than guessing. Each call is a paid request,
# rate limited to 12/minute per IP and cached for 10 minutes per prop+line.
ANTHROPIC_API_KEY=
# Optional. Replaces the built-in placeholder prompt without a code change.
# PROJECTION_SYSTEM_PROMPT_FILE points at a file holding the same thing.
PROJECTION_SYSTEM_PROMPT=
PROJECTION_SYSTEM_PROMPT_FILE=
# Optional model override. Defaults to claude-opus-5.
PROJECTION_MODEL=

# Gemini player-prop projections & grounded reasoning.
# Set GEMINI_API_KEY to activate Gemini. Set PROJECTION_PROVIDER=gemini to use it for projections.
# Models: gemini-3.8-flash (default, high-speed reasoning with thinking budget), gemini-2.5-pro, etc.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_THINKING_BUDGET=4096
ASK_PROVIDER=gemini
ASK_MODEL=gemini-3.8-flash

# Scenario sandbox roster feed. SportsDataIO is switched off globally by
# AUTOSCOUT_DISABLE_SPORTSDATAIO at the frontdoor; this opens only the depth
# chart and injured-player endpoints and leaves the retired board path off.
# The injury endpoint needs the projections entitlement — without it the roster
# still loads and injury status reports as unknown.
AUTOSCOUT_INJURY_FEED=
